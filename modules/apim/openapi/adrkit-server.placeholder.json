{
  "openapi": "3.0.3",
  "info": {
    "title": "adrkit server (placeholder)",
    "version": "0.0.0-placeholder",
    "description": "TODO(openapi): hand-written placeholder of ADR-0055 clause 1's GET routes so the APIM API and MCP tools can be wired before the server exists (adrkit issue #296). Replace with the server's own /openapi.json at the pinned image tag. /healthz is deliberately absent: it is probed inside the environment and never published (ADR-0056 clause 6)."
  },
  "paths": {
    "/api/v1/corpora": {
      "get": {
        "operationId": "listCorpora",
        "summary": "List configured corpora and the commit each is served at.",
        "responses": { "200": { "description": "Corpus keys and commits." } }
      }
    },
    "/api/v1/corpora/{corpus}/records": {
      "get": {
        "operationId": "listRecords",
        "summary": "List the records of one corpus.",
        "parameters": [
          { "name": "corpus", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
        ],
        "responses": { "200": { "description": "{ corpus, commit, data }" }, "503": { "description": "No valid .adrkit-corpus.json sidecar." } }
      }
    },
    "/api/v1/corpora/{corpus}/records/{id}": {
      "get": {
        "operationId": "getRecord",
        "summary": "Get one record by id.",
        "parameters": [
          { "name": "corpus", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "{ corpus, commit, data }" }, "404": { "description": "No such record." } }
      }
    },
    "/api/v1/corpora/{corpus}/graph": {
      "get": {
        "operationId": "getGraph",
        "summary": "Get the decision graph.",
        "parameters": [
          { "name": "corpus", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "kinds", "in": "query", "required": false, "description": "Comma-separated subset of supersedes, relatesTo, conflictsWith.", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "{ corpus, commit, data }" } }
      }
    },
    "/api/v1/corpora/{corpus}/queue": {
      "get": {
        "operationId": "getQueue",
        "summary": "Get the ARB queue.",
        "parameters": [
          { "name": "corpus", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "asOf", "in": "query", "required": false, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "{ corpus, commit, asOf, data }" } }
      }
    },
    "/api/v1/corpora/{corpus}/issues": {
      "get": {
        "operationId": "getIssues",
        "summary": "Get corpus findings (the lint view).",
        "parameters": [
          { "name": "corpus", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "{ corpus, commit, data }" } }
      }
    },
    "/api/v1/corpora/{corpus}/governing": {
      "get": {
        "operationId": "getGoverning",
        "summary": "Get the decisions governing a path.",
        "parameters": [
          { "name": "corpus", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "path", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "{ corpus, commit, data }" } }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "The server's OpenAPI document.",
        "responses": { "200": { "description": "OpenAPI document." } }
      }
    },
    "/": {
      "get": {
        "operationId": "getPortal",
        "summary": "The decision portal (ADR-0054). Published in private mode only (ADR-0056 clause 8).",
        "responses": { "200": { "description": "HTML." } }
      }
    }
  }
}
