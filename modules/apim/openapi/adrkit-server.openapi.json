    "/api/v1/corpora/{corpus}/governing": {
      "get": {
        "operationId": "getGoverning",
        "summary": "Get the decisions whose affects matchers reach an explicitly supplied repository path.",
        "parameters": [
          {
            "name": "corpus",
            "in": "path",
            "required": true,
            "description": "A configured corpus key.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "A repository-relative path, at most 1024 characters. Matched against affects only; never read.",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The data, as { corpus, commit, data }, with commit from the corpus .adrkit-corpus.json. Resolution is withheld, with the corpus issues, when the corpus has errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "path is missing, invalid, or repeated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No corpus is configured under this key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The corpus has no valid .adrkit-corpus.json, could not be loaded, or resolves outside the root.",
