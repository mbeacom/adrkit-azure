{
  "openapi": "3.0.3",
  "info": {
    "title": "adrkit server",
    "version": "1.0.0",
    "description": "Read-only REST API over an adrkit decision corpus (ADR-0055). This server authenticates no one: run it on localhost or behind a gateway that does. Only GET and HEAD are served."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness. The one route whose answer is not tied to a commit.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is serving.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This server's OpenAPI document, generated from its route table.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/corpora": {
      "get": {
        "operationId": "listCorpora",
        "summary": "List the configured decision corpora and the commit each is served at.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The configured keys, each with its commit, or null when it is not being served.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/corpora/{corpus}/records": {
      "get": {
        "operationId": "listRecords",
        "summary": "List the architecture decision records of one corpus, without their bodies.",
        "parameters": [
          {
            "name": "corpus",
            "in": "path",
            "required": true,
            "description": "A configured corpus key.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The data, as { corpus, commit, data }, with commit from the corpus .adrkit-corpus.json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No corpus is configured under this key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The corpus has no valid .adrkit-corpus.json, could not be loaded, or resolves outside the root.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/corpora/{corpus}/records/{id}": {
      "get": {
        "operationId": "getRecord",
        "summary": "Get one architecture decision record by id, with its raw Markdown body.",
        "parameters": [
          {
            "name": "corpus",
            "in": "path",
            "required": true,
            "description": "A configured corpus key.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "A record id: four or more digits, or a ULID.",
            "schema": {
              "type": "string",
              "pattern": "^(?:[0-9]{4,64}|[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26})$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The data, as { corpus, commit, data }, with commit from the corpus .adrkit-corpus.json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a record id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such corpus, or no such record in it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The corpus has no valid .adrkit-corpus.json, could not be loaded, or resolves outside the root.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/corpora/{corpus}/graph": {
      "get": {
        "operationId": "getGraph",
        "summary": "Get the decision relationship graph of one corpus. Supersession edges only unless kinds says otherwise.",
        "parameters": [
          {
            "name": "corpus",
            "in": "path",
            "required": true,
            "description": "A configured corpus key.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "kinds",
            "in": "query",
            "required": false,
            "description": "A comma-separated subset of supersedes, relatesTo, and conflictsWith. Default: supersedes.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The data, as { corpus, commit, data }, with commit from the corpus .adrkit-corpus.json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "kinds is empty, names an unknown kind, or is repeated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No corpus is configured under this key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The corpus has no valid .adrkit-corpus.json, could not be loaded, or resolves outside the root.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/corpora/{corpus}/queue": {
      "get": {
        "operationId": "getQueue",
        "summary": "Get the architecture review queue of one corpus and the SLA state of each proposal.",
        "parameters": [
          {
            "name": "corpus",
            "in": "path",
            "required": true,
            "description": "A configured corpus key.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "asOf",
            "in": "query",
            "required": false,
            "description": "UTC calendar date the SLA states are computed against, YYYY-MM-DD. Default: today (UTC), echoed as asOf.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The queue, as { corpus, commit, asOf, data }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "asOf is not a real calendar date, or is repeated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
